# Copy this file to .env (repo root) or backend/.env and adjust as needed.
# The app starts without any of these values. Docker Compose is the exception:
# it refuses to start until the two Postgres passwords below are set.

# Groq API key used for LLM-generated answers. Without it the app still answers
# price, discount, stock, and availability questions from the catalog.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Defaults to a local SQLite file; docker compose overrides this with Postgres.
DATABASE_URL=sqlite:////tmp/rag-system.db

# Postgres for docker compose. Keep the passwords URL-safe because the app
# database password is embedded in DATABASE_URL. The admin user initialises the
# database; the application connects as APP_DB_USER (non-superuser).
POSTGRES_DB=ragdb
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=
APP_DB_USER=rag_app
APP_DB_PASSWORD=

# Optional overrides. CSV_PATH defaults to data/bangla_products_5k.csv.
# CSV_PATH=/data/bangla_products_5k.csv
# SESSION_TTL_SECONDS=1800
# MAX_SESSIONS=5000
# MAX_RETRIEVAL_RESULTS=5

# Abuse protection for /chat and /chat/stream. Set API_TOKEN to require an
# X-API-Token (or Bearer) header; the bundled UI prompts for it on a 401.
# API_TOKEN=
# RATE_LIMIT_PER_MINUTE is counted per client address. Behind a reverse proxy
# every visitor shares the proxy's address (one bucket for the whole
# deployment) unless TRUST_PROXY_HEADERS=true, which keys on the address the
# proxy appended to X-Forwarded-For. Leave it false when the app is reachable
# directly, because callers could then forge the header.
# RATE_LIMIT_PER_MINUTE=30
# TRUST_PROXY_HEADERS=false
# MAX_CONCURRENT_LLM_CALLS=4
